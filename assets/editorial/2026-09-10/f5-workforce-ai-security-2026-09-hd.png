<svg xmlns="http://www.w3.org/2000/svg" width="1536" height="864"><rect width="100%" height="100%" fill="white"/><text x="80" y="120" font-family="Arial" font-size="54" font-weight="700">Policy sits in the agent interaction path</text><rect x="100" y="280" width="330" height="320" rx="30" fill="#eee" stroke="#111" stroke-width="4"/><text x="155" y="360" font-family="Arial" font-size="34" font-weight="700">USER + AGENT</text><text x="155" y="410" font-family="Arial" font-size="26">CLI / MCP client</text><path d="M430 440 H620" stroke="#111" stroke-width="8"/><polygon points="620,440 580,415 580,465" fill="#111"/><rect x="620" y="240" width="390" height="400" rx="30" fill="#ddd" stroke="#111" stroke-width="4"/><text x="730" y="325" font-family="Arial" font-size="42" font-weight="700">POLICY</text><rect x="700" y="380" width="230" height="55" rx="10" fill="white" stroke="#111" stroke-width="3"/><text x="750" y="417" font-family="Arial" font-size="25">IDENTITY</text><rect x="700" y="470" width="230" height="55" rx="10" fill="white" stroke="#111" stroke-width="3"/><text x="750" y="507" font-family="Arial" font-size="25">TOOL CALL</text><rect x="700" y="560" width="230" height="55" rx="10" fill="white" stroke="#111" stroke-width="3"/><text x="750" y="597" font-family="Arial" font-size="25">DATA RISK</text><path d="M1010 440 H1100" stroke="#111" stroke-width="8"/><polygon points="1100,440 1060,415 1060,465" fill="#111"/><rect x="1100" y="270" width="320" height="350" rx="30" fill="#eee" stroke="#111" stroke-width="4"/><text x="1150" y="350" font-family="Arial" font-size="34" font-weight="700">SYSTEMS</text><text x="1180" y="440" font-family="Arial" font-size="28">ALLOW</text><text x="1180" y="510" font-family="Arial" font-size="28">REVIEW</text><text x="1180" y="580" font-family="Arial" font-size="28">RESTRICT</text></svg>